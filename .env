# Ocean Sentinel AI — environment
PORT=8787

# --- Real AI vision agent (pick one) ---
# xAI Grok (preferred)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_VISION_MODEL=grok-2-vision-1212

# OpenAI-compatible (OpenAI, Azure, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Live AIS vessels (optional) ---
# Free key from https://aisstream.io
AISSTREAM_API_KEY=

# Satellite imagery: NASA GIBS works with ZERO keys (already enabled).
# For Sentinel-1 SAR download API, create a Copernicus Data Space account:
# https://dataspace.copernicus.eu
